{
  "name": "linkedin-easy-apply-orchestrator",
  "version": "1.0.0",
  "description": "Hybrid AI-augmented LinkedIn Easy Apply automation with human-in-the-loop review",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "npx concurrently \"npm run server\" \"npm run ui\"",
    "server": "npx tsx src/server.ts",
    "ui": "cd ui && npm run dev",
    "build": "tsc",
    "filter": "tsx index.ts --filter-only",
    "apply": "tsx index.ts --apply-only",
    "dry-run": "tsx index.ts --apply-only --dry-run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.0",
    "apify-client": "^2.25.0",
    "chalk": "^5.4.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.0",
    "express": "^5.2.1",
    "js-yaml": "^4.1.0",
    "multer": "^2.3.0",
    "openai": "^7.8.0",
    "pdf-parse": "^1.1.1",
    "playwright": "^1.50.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.0.0",
    "concurrently": "^10.0.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
