# ============================================
# Job Jet — Configuration
# ============================================
#
# You can also configure these via the Settings tab in the web UI.
# API keys set here will be loaded on startup and shown in Settings.
#

# Get your free Gemini API key at: https://aistudio.google.com/apikey
# You can add multiple keys comma-separated for automatic failover
# Example: GEMINI_API_KEYS=key1,key2,key3
GEMINI_API_KEYS=

# (Optional) Get your OpenRouter API key at: https://openrouter.ai/keys
# Supports free models like google/gemini-2.5-flash-free
# You can add multiple keys comma-separated for automatic failover
OPENROUTER_API_KEYS=

# Get your Apify API token at: https://console.apify.com/account#/integrations
# Required for the job scraper to pull jobs from LinkedIn
APIFY_API_TOKEN=
